# PharmaLink / counter. — copy to .env (cp .env.example .env). Never commit .env.

# Database (app): hosted Neon PostgreSQL. Paste the full connection string from the Neon console.
# With ?sslmode=require the app connects over TLS with certificate verification.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-PROJECT.REGION.aws.neon.tech/neondb?sslmode=require
# Alternative (offline): bundled PostgreSQL 16 started automatically for localhost URLs:
# DATABASE_URL=postgres://pharmalink:pharmalink@localhost:5433/pharmalink

# Tests wipe their database, so they NEVER use DATABASE_URL. Default: the bundled PostgreSQL 16
# on localhost:5433 (database pharmalink_test), started by the test run. Override if you prefer:
# TEST_DATABASE_URL=postgres://pharmalink:pharmalink@localhost:5433/pharmalink_test
# The bundled PostgreSQL is only ever started for localhost URLs; set EMBEDDED_PG=false to disable it.
EMBEDDED_PG=true

# Auth. Replace JWT_SECRET with a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=8h

PORT=4000
FRONTEND_URL=http://localhost:5173

# Payments: Stripe TEST MODE only (optional). Without these keys the app shows "Payments not configured".
# Keys come from https://dashboard.stripe.com/test/apikeys (test mode: they start with sk_test_). A live key is refused.
# The webhook secret (whsec_...) is printed by `stripe listen` locally, or shown on the webhook endpoint page when hosted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development only: a simulated Stripe page, no keys needed. Refused in production. Leave empty normally.
STRIPE_FAKE=

# Map tiles (optional). MapTiler raster URL, e.g.
# https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# Leave empty to see the "Map tiles are not configured" fallback (pins still work).
# Vite reads this only at startup: restart `npm run dev` after changing it.
VITE_MAP_TILE_URL=

# Email (optional). Without both values nobody is emailed: everything stays an in-app notification.
# Create a free account at https://resend.com, add and verify your sending domain, create an API key. See DEPLOY.md.
RESEND_API_KEY=
MAIL_FROM=

# Error alerts (optional): a webhook URL (Discord, Slack...) that takes {"text": "..."}; one short message per unexpected server error, at most one a minute.
ERROR_WEBHOOK_URL=
