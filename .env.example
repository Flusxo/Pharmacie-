# PharmaLink / counter. — copy to .env (cp .env.example .env). Never commit .env.

# Database. Default = Route C: a real PostgreSQL 16 bundled through npm, started automatically
# on port 5433 by `npm run db:reset`, `npm run dev` and `npm test` (data in db/.pgdata).
# For Docker (Route A) or a local PostgreSQL (Route B) set EMBEDDED_PG=false and point DATABASE_URL at it.
DATABASE_URL=postgres://pharmalink:pharmalink@localhost:5433/pharmalink
EMBEDDED_PG=true

# Auth. Replace JWT_SECRET with a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=8h

PORT=4000
FRONTEND_URL=http://localhost:5173

# Map tiles (optional). MapTiler raster URL, e.g.
# https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# Leave empty to see the "Map tiles are not configured" fallback (pins still work).
# Vite reads this only at startup: restart `npm run dev` after changing it.
VITE_MAP_TILE_URL=
