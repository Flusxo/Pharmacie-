{
  // Cloudflare Workers static assets: serves the built website (npm run build -w frontend).
  // No secrets here: VITE_* values are set as Build variables in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharmacie",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
