# Cloudflare Pages response headers.
# Hashed build files never change under the same name: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Rendered pictures and the environment map keep their names when re-rendered: a week, then check again.
/renders/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/hdr/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=86400

# The page itself is always revalidated, so a new build reaches phones at once (no service worker is registered).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
